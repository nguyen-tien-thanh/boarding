// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum HouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum EntityType {
  HOUSE
  ROOM
  ASSET
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  REPORTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ResourceMember {
  id          Int       @id @default(autoincrement())
  resource    String    @db.VarChar(255)
  resourceId  Int?
  userId      Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("resourceMembers")
  @@unique([resource, resourceId, userId])
}

model House {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(255)
  address     String      @db.Text
  ownerId     Int
  description String?     @db.Text
  totalArea   Int
  status      HouseStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdBy   Int
  updatedBy   Int?

  // Relations
  rooms     Room[]
  qrCode    QRCode?

  @@map("houses")
}

model Room {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(255)
  roomNumber  String     @db.VarChar(50)
  area        Int
  baseRent    Int
  status      RoomStatus @default(AVAILABLE)
  houseId     Int
  description String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   Int
  updatedBy   Int?

  // Relations
  house           House             @relation(fields: [houseId], references: [id], onDelete: Cascade)
  roomAssets      RoomAsset[]
  tenantContracts TenantContract[]
  maintenances    Maintenance[]

  @@map("rooms")
}

model Image {
  id         Int       @id @default(autoincrement())
  imageUrl   String    @db.Text
  entityType EntityType
  entityId   Int
  isPrimary  Boolean   @default(false)
  uploadedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  Int
  updatedBy  Int?

  @@map("images")
  @@index([entityType, entityId])
}

model AssetCategory {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   Int
  updatedBy   Int?

  // Relations
  assets Asset[]

  @@map("assetCategories")
}

model Asset {
  id          Int            @id @default(autoincrement())
  name        String         @db.VarChar(255)
  categoryId  Int
  condition   AssetCondition
  value       Int
  description String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   Int
  updatedBy   Int?

  // Relations
  category   AssetCategory @relation(fields: [categoryId], references: [id])
  roomAssets RoomAsset[]

  @@map("assets")
}

model RoomAsset {
  id        Int            @id @default(autoincrement())
  roomId    Int
  assetId   Int
  quantity  Int
  condition AssetCondition
  addedAt   DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  createdBy Int
  updatedBy Int

  // Relations
  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("roomAssets")
}

model TenantContract {
  id          Int            @id @default(autoincrement())
  tenantId    Int
  roomId      Int
  monthlyRent Int
  deposit     Int
  startDate   DateTime       @db.Date
  endDate     DateTime       @db.Date
  status      ContractStatus @default(PENDING)
  terms       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   Int
  updatedBy   Int?

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("tenantContracts")
}

model QRCode {
  id        Int       @id @default(autoincrement())
  houseId   Int       @unique
  qrData    String    @db.Text
  imageUrl  String    @db.Text
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int
  updatedBy Int?
  expiresAt DateTime?

  // Relations
  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@map("qrCodes")
}

model Maintenance {
  id          Int                 @id @default(autoincrement())
  roomId      Int
  reportedBy  Int
  assignedTo  Int?
  title       String              @db.VarChar(255)
  description String              @db.Text
  priority    MaintenancePriority @default(MEDIUM)
  status      MaintenanceStatus   @default(REPORTED)
  cost        Int?
  reportedAt  DateTime            @default(now())
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   Int
  updatedBy   Int?

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("maintenances")
}